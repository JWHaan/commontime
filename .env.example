# Copy to .env and fill in (never commit .env)
TIMETREE_EMAIL=you@example.com
TIMETREE_PASSWORD=secret
TIMETREE_CALENDAR_CODE=xxxxxx
# Optional overrides
SLOT_TIMEZONE=Asia/Singapore
SLOT_DAY_START=08:00
SLOT_DAY_END=20:00
SLOT_DURATION_MIN=120

# Google provider (pip install -e ".[google]")
# GOOGLE_CLIENT_SECRETS=/path/to/oauth-client.json
# GOOGLE_TOKEN_FILE=~/.config/commontime/google_token.json
# GOOGLE_CALENDARS=alice@example.com,bob@example.com
